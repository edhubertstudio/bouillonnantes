# URL du Worker Cloudflare API (safe to expose — pas un secret)
# Obtenir après : npx wrangler deploy --config cloudflare-worker/wrangler.toml
# Format : https://bouillonnantes-newsletter.<account>.workers.dev
NEXT_PUBLIC_BREVO_WORKER_URL=

# IDs numériques des listes Brevo (dashboard → Contacts → Listes)
NEXT_PUBLIC_BREVO_LIST_ACTUALITES=
NEXT_PUBLIC_BREVO_LIST_RECETTES=
